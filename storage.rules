rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if the authenticated user is the authorized administrator
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nazrulcxd@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Protected digital product files (SerialPlacer.zxp, Serial_Placer_v4.jsx, etc.)
    // Direct client reads are STRICTLY FORBIDDEN.
    // Customers can ONLY download these files via a short-lived V4 Signed URL
    // generated by the server-side Cloud Function after verifying payment status in Firestore.
    match /protected-products/{fileName} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
