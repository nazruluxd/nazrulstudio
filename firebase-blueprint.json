{
  "entities": {
    "review": {
      "title": "Customer Review",
      "description": "Customer ratings and comments for products in the shop",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Reviewer display name"
        },
        "role": {
          "type": "string",
          "maxLength": 100,
          "description": "Job role or title of the reviewer"
        },
        "company": {
          "type": "string",
          "maxLength": 100,
          "description": "Company name or location"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "date": {
          "type": "string",
          "maxLength": 50,
          "description": "Relative or formatted review date"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Headline of the review"
        },
        "comment": {
          "type": "string",
          "maxLength": 2000,
          "description": "Review text"
        },
        "verifiedBuyer": {
          "type": "boolean",
          "description": "Whether the reviewer is a verified purchaser"
        },
        "helpfulCount": {
          "type": "number",
          "description": "Number of users who found this review helpful"
        }
      },
      "required": ["name", "rating", "title", "comment"]
    },
    "siteConfig": {
      "title": "Site Configuration",
      "description": "Persisted site content, shop video settings, and payment security config",
      "type": "object",
      "properties": {
        "global": {
          "type": "object",
          "description": "Global hero and contact configuration"
        },
        "visibility": {
          "type": "object",
          "description": "Section visibility toggle flags"
        },
        "shopVideo": {
          "type": "object",
          "description": "Shop interactive demo video and simulation configuration"
        },
        "paymentSecurity": {
          "type": "object",
          "description": "Payment verification mode and return token settings"
        }
      }
    },
    "license": {
      "title": "Product License Key",
      "description": "Verified license key for downloading Serial Placer",
      "type": "object",
      "properties": {
        "licenseKey": {
          "type": "string",
          "maxLength": 64,
          "description": "Unique license key code (e.g. SP-XXXX-XXXX-XXXX)"
        },
        "buyerEmail": {
          "type": "string",
          "maxLength": 150,
          "description": "Authorized customer email"
        },
        "paypalTxId": {
          "type": "string",
          "maxLength": 64,
          "description": "Associated PayPal Transaction ID"
        },
        "users": {
          "type": "number",
          "description": "Number of licensed seats"
        },
        "amountPaid": {
          "type": "number",
          "description": "Total USD amount paid"
        },
        "status": {
          "type": "string",
          "maxLength": 32,
          "description": "active, pending, or revoked"
        },
        "downloadsCount": {
          "type": "number",
          "description": "Number of times files were downloaded"
        },
        "maxDownloads": {
          "type": "number",
          "description": "Maximum allowed download sessions"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["licenseKey", "status", "users"]
    },
    "order": {
      "title": "Customer Payment Order",
      "description": "PayPal payment verification record and download authorization",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "maxLength": 64,
          "description": "Order ID or PayPal Transaction ID"
        },
        "paypalTxId": {
          "type": "string",
          "maxLength": 64,
          "description": "PayPal Transaction ID from receipt"
        },
        "buyerEmail": {
          "type": "string",
          "maxLength": 150,
          "description": "Customer PayPal email address"
        },
        "users": {
          "type": "number",
          "description": "Number of user licenses purchased"
        },
        "amount": {
          "type": "number",
          "description": "Total amount in USD"
        },
        "status": {
          "type": "string",
          "maxLength": 32,
          "description": "pending, verified, or revoked"
        },
        "licenseKey": {
          "type": "string",
          "maxLength": 64,
          "description": "Issued license key once verified"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp"
        }
      },
      "required": ["orderId", "paypalTxId", "buyerEmail", "users", "amount", "status"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Customer reviews and testimonials for shop products"
    },
    "/siteConfig/{configId}": {
      "schema": "siteConfig",
      "description": "Global website configuration and demo video settings"
    },
    "/licenses/{licenseKey}": {
      "schema": "license",
      "description": "Verified software license keys for Serial Placer download"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "PayPal transaction verification requests and verified orders"
    }
  }
}
