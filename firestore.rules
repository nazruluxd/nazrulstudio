rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly authorize only nazrulcxd@gmail.com with verified email
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'nazrulcxd@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidReview(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && (!('role' in data) || (data.role is string && data.role.size() <= 100))
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && (!('verifiedBuyer' in data) || data.verifiedBuyer is bool)
        && (!('helpfulCount' in data) || data.helpfulCount is number);
    }

    function isValidOrderSubmission(data) {
      return data.orderId is string && data.orderId.size() >= 8 && data.orderId.size() <= 64
        && data.paypalTxId is string && data.paypalTxId.size() >= 10 && data.paypalTxId.size() <= 64
        && data.buyerEmail is string && data.buyerEmail.size() >= 5 && data.buyerEmail.size() <= 150
        && data.users is number && data.users >= 1 && data.users <= 50
        && data.amount is number && data.amount >= 20
        && data.status in ['pending', 'verified']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer Reviews collection - public get & list (do not apply isValidId on list queries), validated create, helpfulCount update, admin delete
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update: if isValidId(reviewId) 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])
        && request.resource.data.helpfulCount is number;
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // Site Configuration - readable by all, writable only by nazrulcxd@gmail.com
    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow write: if isValidId(configId) && isAdmin();
    }

    // Product License Keys - single document lookup allowed by exact key, listing & creation restricted to Admin
    match /licenses/{licenseKey} {
      allow get: if isValidId(licenseKey);
      allow list: if isAdmin();
      allow create, delete: if isValidId(licenseKey) && isAdmin();
      allow update: if isValidId(licenseKey) && (
        isAdmin() ||
        (
          resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount', 'lastDownloadAt', 'buyerEmail'])
          && request.resource.data.downloadsCount is number
          && request.resource.data.downloadsCount <= resource.data.maxDownloads
        )
      );
    }

    // Customer Payment Orders - single document lookup by ID, list only by Admin, create validated, full control by Admin
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrderSubmission(request.resource.data);
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // Connection testing doc
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow write: if isValidId(docId);
    }
  }
}
